[Unit]
Description=AFW controller (telemetry, detection, policy, reconciliation, API, dashboard)
After=network-online.target
Wants=network-online.target

[Service]
User=afwctl
Group=afwctl
Environment=AFW_CONFIG=/etc/afw/lab.yaml
Environment=AFW_DATA_DIR=/var/lib/afw
Environment=AFW_API_TOKENS_FILE=/etc/afw/secrets/api_tokens.yaml
{% if controller_tls | default(true) %}
# HTTPS by default (ADR-023, revised 2026-10-28). The lab-CA leaf carries
# 10.77.50.10, ctrl01.lab.afw, localhost and 127.0.0.1, so direct MGMT access and
# the operator's SSH tunnel both verify against the lab CA.
Environment=AFW_TLS_CERT=/etc/afw/secrets/ctrl01.pem
Environment=AFW_TLS_KEY=/etc/afw/secrets/ctrl01.key
{% endif %}
WorkingDirectory=/var/lib/afw
ExecStartPre=/opt/afw/venv/bin/afw db upgrade
ExecStart=/opt/afw/venv/bin/afw serve --host {{ ctrl_ip }} --port 8080
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/afw
PrivateTmp=true
# Further sandboxing (systemd-analyze security afw-controller). The service needs only
# TCP/UDP/unix sockets on ports above 1024 and no capabilities.
CapabilityBoundingSet=
AmbientCapabilities=
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectKernelLogs=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
ProtectProc=invisible
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX AF_NETLINK
RestrictNamespaces=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
