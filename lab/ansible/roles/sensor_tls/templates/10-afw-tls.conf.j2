# Managed by Ansible (AFW): TLS material for the telemetry channel (ADR-029)
global(
  DefaultNetstreamDriver="gtls"
  DefaultNetstreamDriverCAFile="/etc/afw/telemetry/ca.pem"
  DefaultNetstreamDriverCertFile="/etc/afw/telemetry/client.pem"
  DefaultNetstreamDriverKeyFile="/etc/afw/telemetry/client.key"
)
